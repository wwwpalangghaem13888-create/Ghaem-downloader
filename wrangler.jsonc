{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghaem-downloader",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": { "directory": "./dashboard", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "vars": {
    "APP_ENV": "production",
    "MAX_TASKS_PER_TELEGRAM_USER_PER_DAY": "10",
    "MAX_PENDING_TASKS_PER_USER": "3",
    "MAX_R2_BYTES": "524288000",
    "MAX_R2_OBJECTS": "1000",
    "RETENTION_HOURS": "24",
    "ALLOWED_MEDIA_HOSTS": "youtube.com,youtu.be,instagram.com,tiktok.com,x.com,twitter.com,facebook.com,pinterest.com,reddit.com,soundcloud.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "ghaem-downloader", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ghaem-downloader-temp" }],
  "queues": {
    "producers": [{ "binding": "TASK_QUEUE", "queue": "ghaem-download-tasks" }],
    "consumers": [{ "queue": "ghaem-download-tasks", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 2, "dead_letter_queue": "ghaem-download-dlq" }]
  },
  "triggers": { "crons": ["17 * * * *"] }
}
