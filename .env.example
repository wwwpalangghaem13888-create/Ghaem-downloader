APP_NAME=Ghaem Downloader
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=replace-with-at-least-32-random-bytes
BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://ghaem:replace-with-a-strong-random-password@db:5432/ghaem
POSTGRES_DB=ghaem
POSTGRES_USER=ghaem
POSTGRES_PASSWORD=replace-with-a-strong-random-password
REDIS_URL=redis://redis:6379/0
MAX_DOWNLOAD_MB=250
DOWNLOAD_TIMEOUT_SECONDS=300
ALLOWED_DOWNLOAD_HOSTS=youtube.com,youtu.be,instagram.com,tiktok.com,x.com,twitter.com,facebook.com,pinterest.com,reddit.com,soundcloud.com
