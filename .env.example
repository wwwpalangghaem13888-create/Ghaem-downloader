APP_NAME=Ghaem Downloader
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-a-long-random-admin-api-key
DASHBOARD_ACCESS_TOKEN=replace-with-a-different-long-random-dashboard-token
BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://ghaem:replace-with-32-char-hex-password@db:5432/ghaem
POSTGRES_DB=ghaem
POSTGRES_USER=ghaem
POSTGRES_PASSWORD=replace-with-32-char-hex-password
REDIS_URL=redis://redis:6379/0
DOWNLOAD_DIR=/downloads
MAX_DOWNLOAD_MB=250
TELEGRAM_UPLOAD_LIMIT_MB=45
COMPLETED_FILE_RETENTION_HOURS=24
ALLOWED_DOWNLOAD_HOSTS=youtube.com,youtu.be,instagram.com,tiktok.com,x.com,twitter.com,facebook.com,pinterest.com,reddit.com,soundcloud.com
